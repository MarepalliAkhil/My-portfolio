# ==============================================================
# Akhil Marepalli Space Portfolio - Environment Configuration
# ==============================================================
# Copy this file to .env and configure the values below.
# Never commit your actual .env file with secrets to Git.

# Node Server Port (default: 8000)
PORT=8000
NODE_ENV=production

# --------------------------------------------------------------
# 1. Email Delivery Settings (Choose ONE provider: Resend, SendGrid, or SMTP)
# --------------------------------------------------------------
# The email address that will receive Hire Me messages and Monthly Reports
RECIPIENT_EMAIL=your-email@example.com

# OPTION A: Resend (Recommended - easiest setup at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Akhil Portfolio <onboarding@resend.dev>"

# OPTION B: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# EMAIL_FROM="Akhil Portfolio <verified-sender@example.com>"

# OPTION C: Standard SMTP (Gmail, Outlook, Hostinger, AWS SES, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username@example.com
# SMTP_PASS=your-smtp-app-password
# SMTP_FROM="Akhil Portfolio <your-smtp-username@example.com>"

# --------------------------------------------------------------
# 2. Monthly Visitor Analytics & Salt
# --------------------------------------------------------------
# Secret salt used for anonymous SHA-256 visitor hashing
VISITOR_SALT=change_this_to_a_random_secret_salt_string_123

# Timezone for calendar month boundary calculations (default: UTC)
TIMEZONE=UTC

# --------------------------------------------------------------
# 3. Scheduled Monthly Report Security
# --------------------------------------------------------------
# Secret token to authorize monthly report triggering (e.g. from Vercel Cron or external scheduler)
CRON_SECRET=generate_a_secure_random_cron_token_here
