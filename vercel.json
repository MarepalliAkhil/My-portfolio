{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/textures/(.*)", "destination": "/textures/$1" },
    { "source": "/resume.pdf", "destination": "/resume.pdf" },
    { "source": "/((?!api/|textures/|resume.pdf).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/monthly-report",
      "schedule": "0 0 1 * *"
    }
  ]
}
